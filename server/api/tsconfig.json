{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@anthos/shared": ["../../shared/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../shared/src/**/*.ts"
  ]
}

